#usda 1.0
(
    customLayerData = {
        string Copyright = "Copyright 2022 - 2024 PICO. All rights reserved."
        string RuntimeVersion = "Runtime V0.10.3.0.alpha.7"
        string Version = "Spatial Editor V0.10.2-alpha.3"
    }
    defaultPrim = "Root"
    doc = "spatial editor 0.1"
    endTimeCode = 0
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Y"
)

def Xform "Root"
{
    quatf xformOp:orient = (1, 0, 0, 0) (
        customData = {
            float3 euler = (0, 0, 0)
        }
    )
    float3 xformOp:scale = (1, 1, 1)
    float3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

    def Xform "DirectionalLight"
    {
        quatf xformOp:orient = (0.9396926, -0.34202015, 0, 0) (
            customData = {
                float3 euler = (-40, 0, 0)
            }
        )
        float3 xformOp:scale = (1, 1, 1)
        float3 xformOp:translate = (0.213, 0.471, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def SpatialComponent "DirectionalLightComponent"
        {
            bool castsShadowEnabled = 0
            uniform token info:id = "DirectionalLightComponent"
            uint64 info:typeId = 2727022354109603371
            float intensity = 3000
        }
    }

    def "box" (
        prepend references = @../Assets/box.usdz@
    )
    {
        quatf xformOp:orient = (0.70710677, 0.70710677, 0, 0) (
            customData = {
                float3 euler = (90, 0, 0)
            }
        )
        float3 xformOp:scale = (1, 0.9999995, 1.0000001)
        float3 xformOp:translate = (0, 0, 0)
    }
}

